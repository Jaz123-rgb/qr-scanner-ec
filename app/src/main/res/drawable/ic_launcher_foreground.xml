<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground — "ON" in bold geometric yellow (#FFE600).
  Safe zone: 72×72dp centered in 108×108dp canvas (x=18–90, y=18–90).

  O  →  x=18–48, y=20–88  (30×68, ring with 8dp stroke, evenOdd fill)
  N  →  x=52–90, y=20–88  (38×68, three filled shapes)
         · left bar   x=52–62
         · diagonal   parallelogram from (62,20)–(72,20) to (80,88)–(90,88)
         · right bar  x=80–90
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- O: outer rounded rect + inner cutout → ring shape -->
    <path
        android:fillColor="#FFE600"
        android:fillType="evenOdd"
        android:pathData="
            M18,30 Q18,20 28,20 L38,20 Q48,20 48,30
            L48,78 Q48,88 38,88 L28,88 Q18,88 18,78 Z
            M26,34 Q26,28 32,28 L34,28 Q40,28 40,34
            L40,74 Q40,80 34,80 L32,80 Q26,80 26,74 Z"/>

    <!-- N: left bar + diagonal + right bar -->
    <path
        android:fillColor="#FFE600"
        android:pathData="
            M52,20 L62,20 L62,88 L52,88 Z
            M62,20 L72,20 L90,88 L80,88 Z
            M80,20 L90,20 L90,88 L80,88 Z"/>

</vector>
